"""
Precedent & Trust System  (Kies-Oz / SD Worx case)
==================================================

A secondary system that BACKS UP the main AI search engine.

    AI engine  ->  finds documents relevant to the client's problem
    This module -> tells the consultant how much those documents can be TRUSTED,
                   based on what previous consultants actually found useful.

It does NOT search. It only:
  1. Collects feedback   : upvote / downvote / "used it, problem solved (or not)"
  2. Builds a track record per document (the precedent)
  3. Scores trust, assigns a tier (Proven / Promising / Unverified / Disputed)
  4. Attaches that evidence to the AI engine's results, and (optionally)
     blends trust into the AI ranking.
  5. Builds a client profile to give the precedent a context.

Typical flow
------------
    ps = PrecedentSystem(companies, cases, documents)

    # 1. AI engine returns candidates (ids, or ids + its own relevance score)
    ai_results = [{"doc_id": "doc-008", "ai_score": 0.92}, {"doc_id": "doc-001", "ai_score": 0.70}]

    # 2. Attach proof / credibility
    verified = ps.verify(ai_results, company_id="comp-001", problem_category="salary_adjustment")

    # 3. Consultant opens a document, uses it, then gives feedback
    ps.record_use("doc-008", "cons-A", company_id="comp-001",
                  problem_category="salary_adjustment", solved=True)
    ps.upvote("doc-008", "cons-A", comment="Exact same inflation clause we needed")
"""

from __future__ import annotations

import json
import math
import re
from collections import Counter, defaultdict
from datetime import datetime, timezone
from pathlib import Path
from typing import Iterable, Optional, Union

# --------------------------------------------------------------------------
# Configuration
# --------------------------------------------------------------------------
TRUST_WEIGHTS = {          # must sum to 1.0
    "votes": 0.40,         # upvotes vs downvotes (confidence-adjusted)
    "success": 0.20,       # share of uses that actually solved the problem
    "usage": 0.15,         # how often consultants relied on it
    "citations": 0.15,     # how many other documents reference it
    "recency": 0.10,       # newer precedent matters more
}
RECENCY_HALF_LIFE_YEARS = 4.0
WILSON_Z = 1.96            # 95% confidence
PRIOR_WEIGHT = 3           # pseudo-observations at neutral 0.5 (cold start)
AI_WEIGHT_DEFAULT = 0.7    # share of the AI engine's score in the blended rank

# ---- Tier rules ---------------------------------------------------------
# Labels say what the consultant should DO, not just how popular a document is.
VERIFIED_MIN_VOTES = 3          # verified precedent needs votes AND solved outcomes
VERIFIED_MIN_OUTCOMES = 3
VERIFIED_MIN_RATE = 0.75        # upvote share and solve share
EARLY_POSITIVE_MIN_RATE = 0.60
CAUTION_MAX_RATE = 0.40         # below this (with >=3 data points) -> caution
CONFIDENCE_MODERATE_AT = 3      # observations (votes + known outcomes) in scope
CONFIDENCE_HIGH_AT = 8
STALE_AFTER_DAYS = 730          # precedent not re-confirmed for ~2 years expires

# The tier adjusts the final rank, so tier and ordering never contradict.
TIER_MULTIPLIER = {
    "Verified precedent": 1.00,
    "Early positive": 1.00,
    "Mixed results": 0.90,
    "Use with caution": 0.70,
    "Not yet rated": 1.00,
}
TIER_ACTION = {
    "Verified precedent": "Safe to cite to the client as precedent.",
    "Early positive": "Looks good so far - confirm the details before citing it.",
    "Mixed results": "Results are inconsistent - read carefully and check fit.",
    "Use with caution": "Prior consultants had problems with it - verify before relying on it.",
    "Not yet rated": "No track record yet - treat as the AI engine's suggestion only.",
}

# Problem categories (used to give precedent a context; the AI engine can also
# pass its own `problem_category` string).
CATEGORY_KEYWORDS = {
    "pay_equity": ["unequal pay", "gender pay", "pay gap", "equal role"],
    "overtime": ["overtime"],
    "bonus": ["bonus"],
    "remote_work": ["remote"],
    "leave": ["parental", "leave"],
    "equity_compensation": ["stock option", "vesting", "stock"],
    "collective_bargaining": ["wage agreement", "bargaining", "deadlock"],
    "salary_adjustment": ["inflation", "cost-of-living", "cost of living", "adjustment"],
    "worker_classification": ["misclassification", "contractor"],
    "executive_pay": ["executive"],
    "shift_premium": ["night-shift", "shift premium"],
}


def categorize(text: str) -> set[str]:
    t = text.lower()
    return {c for c, kws in CATEGORY_KEYWORDS.items() if any(k in t for k in kws)}


def _now() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


# --------------------------------------------------------------------------
# Main class
# --------------------------------------------------------------------------
class PrecedentSystem:
    def __init__(
        self,
        companies_path: str,
        cases_path: str,
        documents_path: str,
        feedback_path: str = "feedback.json",
        reference_year: Optional[int] = None,
        as_of: Optional[datetime] = None,
    ):
        self.companies = {c["id"]: c for c in self._load(companies_path)["companies"]}
        self.cases = {c["id"]: c for c in self._load(cases_path)["cases"]}
        self.documents = {}
        for d in self._load(documents_path)["documents"]:
            if "company_id" not in d:  # older mock without ids -> resolve by name
                d["company_id"] = next(
                    (i for i, c in self.companies.items() if c["name"] == d.get("company_involved")), None
                )
            self.documents[d["id"]] = d

        self.reference_year = reference_year or datetime.now().year
        self.as_of = as_of or datetime.now(timezone.utc)   # 'today' for staleness checks
        self.feedback_path = Path(feedback_path)
        # feedback[doc_id] = {"votes": {consultant: {...}}, "uses": [ {...}, ... ]}
        self.feedback: dict[str, dict] = defaultdict(lambda: {"votes": {}, "uses": []})
        self._load_feedback()

    # ------------------------------------------------------------------ io
    @staticmethod
    def _load(path) -> dict:
        with open(path, encoding="utf-8") as f:
            return json.load(f)

    def _load_feedback(self) -> None:
        if self.feedback_path.exists():
            raw = json.loads(self.feedback_path.read_text(encoding="utf-8"))
            for doc_id, fb in raw.items():
                self.feedback[doc_id] = {"votes": fb.get("votes", {}), "uses": fb.get("uses", [])}

    def _save(self) -> None:
        self.feedback_path.write_text(json.dumps(self.feedback, indent=2), encoding="utf-8")

    def _check(self, doc_id: str) -> None:
        if doc_id not in self.documents:
            raise KeyError(f"Unknown document: {doc_id}")

    # ================================================================
    # 1. FEEDBACK COLLECTION
    # ================================================================
    def record_use(
        self,
        doc_id: str,
        consultant_id: str,
        company_id: Optional[str] = None,
        problem_category: Optional[str] = None,
        solved: Optional[bool] = None,
    ) -> None:
        """
        A consultant opened and relied on a document the AI engine suggested.
        `solved` = did it actually help resolve the client's problem?
        (None = outcome not known yet; use `report_outcome` later.)
        """
        self._check(doc_id)
        self.feedback[doc_id]["uses"].append({
            "consultant": consultant_id,
            "company_id": company_id,
            "problem_category": problem_category,
            "solved": solved,
            "ts": _now(),
        })
        self._save()

    def report_outcome(self, doc_id: str, consultant_id: str, solved: bool) -> bool:
        """Fill in the outcome of the consultant's most recent use with unknown result."""
        self._check(doc_id)
        for use in reversed(self.feedback[doc_id]["uses"]):
            if use["consultant"] == consultant_id and use["solved"] is None:
                use["solved"] = solved
                self._save()
                return True
        return False

    def vote(
        self,
        doc_id: str,
        consultant_id: str,
        value: int,
        company_id: Optional[str] = None,
        problem_category: Optional[str] = None,
        comment: Optional[str] = None,
    ) -> None:
        """+1 upvote, -1 downvote, 0 retract. One vote per consultant per document."""
        self._check(doc_id)
        if value not in (-1, 0, 1):
            raise ValueError("value must be +1, -1 or 0")
        votes = self.feedback[doc_id]["votes"]
        if value == 0:
            votes.pop(consultant_id, None)
        else:
            votes[consultant_id] = {
                "value": value, "company_id": company_id,
                "problem_category": problem_category, "comment": comment, "ts": _now(),
            }
        self._save()

    def upvote(self, doc_id: str, consultant_id: str, **ctx) -> None:
        self.vote(doc_id, consultant_id, +1, **ctx)

    def downvote(self, doc_id: str, consultant_id: str, **ctx) -> None:
        self.vote(doc_id, consultant_id, -1, **ctx)

    # ================================================================
    # 2. TRACK RECORD (the precedent)
    # ================================================================
    def _counts(self, doc_id: str) -> dict:
        fb = self.feedback[doc_id]
        up = sum(1 for v in fb["votes"].values() if v["value"] > 0)
        down = sum(1 for v in fb["votes"].values() if v["value"] < 0)
        known = [u for u in fb["uses"] if u["solved"] is not None]
        return {
            "upvotes": up, "downvotes": down,
            "uses": len(fb["uses"]),
            "outcomes_known": len(known),
            "solved": sum(1 for u in known if u["solved"]),
            "distinct_consultants": len(
                {u["consultant"] for u in fb["uses"]} | set(fb["votes"])
            ),
        }

    def _citation_counts(self) -> Counter:
        c: Counter = Counter()
        for d in self.documents.values():
            for ref in d.get("referenced_documents", []):
                c[ref] += 1
        return c

    def precedent_record(
        self,
        doc_id: str,
        company_id: Optional[str] = None,
        problem_category: Optional[str] = None,
    ) -> dict:
        """Raw, human-verifiable track record for one document."""
        self._check(doc_id)
        fb = self.feedback[doc_id]
        rec = self._counts(doc_id)
        rec["cited_by"] = self._citation_counts()[doc_id]
        rec["last_used"] = max((u["ts"] for u in fb["uses"]), default=None)
        rec["comments"] = [
            {"consultant": c, "vote": v["value"], "comment": v["comment"]}
            for c, v in fb["votes"].items() if v.get("comment")
        ]

        # precedent in the *same context* as the current request
        def ctx_stats(pred):
            uses = [u for u in fb["uses"] if pred(u)]
            known = [u for u in uses if u["solved"] is not None]
            return {"uses": len(uses), "solved": sum(1 for u in known if u["solved"]),
                    "outcomes_known": len(known)}

        if company_id:
            rec["same_client"] = ctx_stats(lambda u: u["company_id"] == company_id)
        if problem_category:
            rec["same_problem_type"] = ctx_stats(lambda u: u["problem_category"] == problem_category)
        return rec

    # ================================================================
    # 3. TRUST SCORE + TIER
    # ================================================================
    @staticmethod
    def _wilson_lower_bound(up: int, down: int, z: float = WILSON_Z) -> float:
        n = up + down
        if n == 0:
            return 0.0
        p = up / n
        denom = 1 + z * z / n
        centre = p + z * z / (2 * n)
        margin = z * math.sqrt((p * (1 - p) + z * z / (4 * n)) / n)
        return max(0.0, (centre - margin) / denom)

    def trust_score(self, doc_id: str) -> dict:
        """Trust score in [0, 1] with a transparent breakdown."""
        self._check(doc_id)
        c = self._counts(doc_id)
        n_votes = c["upvotes"] + c["downvotes"]

        # votes: confidence-adjusted, neutral prior for unvoted docs
        wilson = self._wilson_lower_bound(c["upvotes"], c["downvotes"])
        votes = (wilson * n_votes + 0.5 * PRIOR_WEIGHT) / (n_votes + PRIOR_WEIGHT)

        # success: smoothed solve rate
        success = (c["solved"] + 0.5 * PRIOR_WEIGHT) / (c["outcomes_known"] + PRIOR_WEIGHT)

        # usage: log-scaled relative to the most-used document
        max_uses = max((len(fb["uses"]) for fb in self.feedback.values()), default=0)
        usage = math.log1p(c["uses"]) / math.log1p(max_uses) if max_uses else 0.0

        # citations: relative to the most-cited document
        cites = self._citation_counts()
        max_cit = max(cites.values(), default=0)
        citations = cites[doc_id] / max_cit if max_cit else 0.0

        # recency: half-life decay on the document year
        age = max(0, self.reference_year - self.documents[doc_id].get("year", self.reference_year))
        recency = 0.5 ** (age / RECENCY_HALF_LIFE_YEARS)

        parts = {"votes": votes, "success": success, "usage": usage,
                 "citations": citations, "recency": recency}
        score = sum(TRUST_WEIGHTS[k] * v for k, v in parts.items())
        return {"score": round(score, 4), "components": {k: round(v, 4) for k, v in parts.items()}}

    # ---- scoped statistics: same problem type if we have it, else overall ----
    @staticmethod
    def _stats(votes: list, uses: list, basis: str) -> dict:
        known = [u for u in uses if u["solved"] is not None]
        stamps = [x["ts"] for x in list(votes) + list(uses) if x.get("ts")]
        return {
            "basis": basis,
            "upvotes": sum(1 for v in votes if v["value"] > 0),
            "downvotes": sum(1 for v in votes if v["value"] < 0),
            "outcomes_known": len(known),
            "solved": sum(1 for u in known if u["solved"]),
            "last_ts": max(stamps) if stamps else None,
        }

    def _scoped_stats(self, doc_id: str, problem_category: Optional[str] = None) -> dict:
        fb = self.feedback[doc_id]
        votes, uses = list(fb["votes"].values()), fb["uses"]
        if problem_category:
            v = [x for x in votes if x.get("problem_category") == problem_category]
            u = [x for x in uses if x.get("problem_category") == problem_category]
            if v or any(x["solved"] is not None for x in u):
                return self._stats(v, u, "same problem type")
        return self._stats(votes, uses, "all problem types")

    def tier(self, doc_id: str, company_id: Optional[str] = None,
             problem_category: Optional[str] = None) -> dict:
        """
        Context-aware verdict. Returns:
          label       : Verified precedent / Early positive / Mixed results /
                        Use with caution / Not yet rated
          confidence  : none / low / moderate / high (how much evidence backs it)
          basis       : "same problem type" or "all problem types"
          stale       : True if the last confirmation is older than STALE_AFTER_DAYS
          action      : what the consultant should do
          reason      : the numbers behind the label
        """
        self._check(doc_id)
        s = self._scoped_stats(doc_id, problem_category)
        nv = s["upvotes"] + s["downvotes"]
        known = s["outcomes_known"]
        n_obs = nv + known
        vote_rate = s["upvotes"] / nv if nv else None
        solve_rate = s["solved"] / known if known else None

        # staleness of the most recent confirmation
        stale, age_days = False, None
        if s["last_ts"]:
            age_days = (self.as_of - datetime.fromisoformat(s["last_ts"])).days
            stale = age_days > STALE_AFTER_DAYS

        negative = (
            (nv >= 3 and vote_rate < CAUTION_MAX_RATE)
            or (known >= 3 and solve_rate < CAUTION_MAX_RATE)
            or (n_obs >= 1 and s["upvotes"] == 0 and s["solved"] == 0)   # only bad news so far
        )
        verified = (
            nv >= VERIFIED_MIN_VOTES and vote_rate >= VERIFIED_MIN_RATE
            and known >= VERIFIED_MIN_OUTCOMES and solve_rate >= VERIFIED_MIN_RATE
        ) if (nv and known) else False
        positive = (
            (s["upvotes"] >= 1 or s["solved"] >= 1)
            and (vote_rate is None or vote_rate >= EARLY_POSITIVE_MIN_RATE)
            and (solve_rate is None or solve_rate >= EARLY_POSITIVE_MIN_RATE)
        )

        if n_obs == 0:
            label = "Not yet rated"
        elif negative:
            label = "Use with caution"
        elif verified and not stale:
            label = "Verified precedent"
        elif verified or positive:          # verified-but-stale is downgraded
            label = "Early positive"
        else:
            label = "Mixed results"

        confidence = ("none" if n_obs == 0 else
                      "high" if n_obs >= CONFIDENCE_HIGH_AT else
                      "moderate" if n_obs >= CONFIDENCE_MODERATE_AT else "low")

        if n_obs == 0:
            reason = "no consultant feedback yet"
        else:
            parts = []
            if nv:
                parts.append(f"{s['upvotes']} up / {s['downvotes']} down")
            if known:
                parts.append(f"{s['solved']}/{known} solved")
            reason = ", ".join(parts) + f" ({s['basis']})"
        if stale:
            reason += f"; last confirmed {age_days // 30} months ago - may be outdated"

        return {"label": label, "confidence": confidence, "basis": s["basis"],
                "stale": stale, "action": TIER_ACTION[label], "reason": reason}

    def evidence(self, doc_id: str, company_id: Optional[str] = None,
                 problem_category: Optional[str] = None) -> str:
        """One-line, human-readable proof the consultant can show the client."""
        r = self.precedent_record(doc_id, company_id, problem_category)
        if r["upvotes"] + r["downvotes"] + r["uses"] == 0 and r["cited_by"] == 0:
            return "No consultant feedback yet."
        bits = []
        if r["upvotes"] + r["downvotes"]:
            bits.append(f"{r['upvotes']} upvote(s) / {r['downvotes']} downvote(s) "
                        f"from {r['distinct_consultants']} consultant(s)")
        if r["outcomes_known"]:
            bits.append(f"solved the problem {r['solved']}/{r['outcomes_known']} times used")
        elif r["uses"]:
            bits.append(f"used {r['uses']} time(s), outcome pending")
        if r["cited_by"]:
            bits.append(f"cited by {r['cited_by']} other document(s)")
        st = r.get("same_problem_type")
        if st and st["outcomes_known"]:
            bits.append(f"same problem type: {st['solved']}/{st['outcomes_known']} solved")
        sc = r.get("same_client")
        if sc and sc["uses"]:
            bits.append(f"already used for this client {sc['uses']}x")
        return "; ".join(bits) + "."

    # ================================================================
    # 4. BACK-UP FOR THE AI ENGINE
    # ================================================================
    def verify(
        self,
        ai_results: Iterable[Union[str, dict]],
        company_id: Optional[str] = None,
        problem_category: Optional[str] = None,
        ai_weight: float = AI_WEIGHT_DEFAULT,
    ) -> list[dict]:
        """
        Attach credibility to the AI engine's candidate documents.

        ai_results : list of doc ids, or dicts {"doc_id": ..., "ai_score": 0..1}
                     (keep the AI engine's order if no scores are given)
        Returns each document with:
           ai_score, trust_score, tier, evidence, precedent, combined_score,
           plus `ai_rank` and `trusted_rank` so the consultant sees both views.
        """
        items = []
        n = len(list(ai_results)) if not isinstance(ai_results, list) else len(ai_results)
        for i, r in enumerate(ai_results):
            doc_id, ai_score = (r, None) if isinstance(r, str) else (r["doc_id"], r.get("ai_score"))
            if ai_score is None:                      # derive from position
                ai_score = 1.0 - i / max(1, n)
            self._check(doc_id)
            t = self.trust_score(doc_id)
            td = self.tier(doc_id, company_id, problem_category)
            raw = ai_weight * ai_score + (1 - ai_weight) * t["score"]
            items.append({
                "doc_id": doc_id,
                "title": self.documents[doc_id]["title"],
                "ai_rank": i + 1,
                "ai_score": round(ai_score, 4),
                "trust_score": t["score"],
                "trust_components": t["components"],
                "tier": td["label"],
                "tier_detail": td,
                "evidence": self.evidence(doc_id, company_id, problem_category),
                "precedent": self.precedent_record(doc_id, company_id, problem_category),
                "score_before_tier": round(raw, 4),
                "combined_score": round(raw * TIER_MULTIPLIER[td["label"]], 4),
            })
        for rank, it in enumerate(sorted(items, key=lambda x: x["combined_score"], reverse=True), 1):
            it["trusted_rank"] = rank
        return sorted(items, key=lambda x: x["trusted_rank"])

    def trusted_contacts(self, doc_ids: Iterable[str], top_n: int = 5) -> list[dict]:
        """Employees behind the recommended documents, ranked by document trust."""
        scores: Counter = Counter()
        docs_of: dict = defaultdict(list)
        for doc_id in doc_ids:
            t = self.trust_score(doc_id)["score"]
            for emp in self.documents[doc_id].get("employees_involved", []):
                scores[emp] += t
                docs_of[emp].append(doc_id)
        return [{"name": n, "reliability": round(s, 3), "documents": docs_of[n]}
                for n, s in scores.most_common(top_n)]

    def leaderboard(self, top_n: int = 10) -> list[dict]:
        """Most trusted documents overall (for monitoring the system)."""
        rows = [{"doc_id": d, "title": doc["title"], "tier": self.tier(d)["label"],
                 "trust_score": self.trust_score(d)["score"], **self._counts(d)}
                for d, doc in self.documents.items()]
        return sorted(rows, key=lambda r: r["trust_score"], reverse=True)[:top_n]

    # ================================================================
    # 5. CLIENT PROFILE (context for the precedent)
    # ================================================================
    def _company_categories(self, company_id: str) -> Counter:
        cats: Counter = Counter()
        for cid in self.companies[company_id].get("case_ids", []):
            if cid in self.cases:
                for c in categorize(self.cases[cid]["title"]):
                    cats[c] += 1
        return cats

    def _similarity(self, a: str, b: str) -> float:
        ca, cb = self.companies[a], self.companies[b]
        sa, sb = set(self._company_categories(a)), set(self._company_categories(b))
        jac = len(sa & sb) / len(sa | sb) if (sa | sb) else 0.0
        return 0.4 * (ca["industry"] == cb["industry"]) + 0.2 * (ca["country"] == cb["country"]) + 0.4 * jac

    def client_profile(self, company_id: str) -> dict:
        if company_id not in self.companies:
            raise KeyError(f"Unknown company: {company_id}")
        co = self.companies[company_id]
        cases = [self.cases[c] for c in co.get("case_ids", []) if c in self.cases]
        solved = [c for c in cases if c["status"] == "solved"]
        cats = self._company_categories(company_id)
        docs = [d["id"] for d in self.documents.values() if d["company_id"] == company_id]

        sims = sorted(
            ((o, self._similarity(company_id, o)) for o in self.companies if o != company_id),
            key=lambda s: s[1], reverse=True)
        sims = [s for s in sims if s[1] > 0][:3]

        predicted: Counter = Counter()
        for other, sim in sims:
            for cat, n in self._company_categories(other).items():
                if cat not in cats:
                    predicted[cat] += sim * n
        total = sum(predicted.values()) or 1

        return {
            "company": co["name"], "country": co["country"], "industry": co["industry"],
            "cases_total": len(cases), "cases_solved": len(solved),
            "solve_rate": round(len(solved) / len(cases), 2) if cases else None,
            "most_recent_case": max(cases, key=lambda c: c["year"], default=None),
            "problem_categories": dict(cats),
            "documents": docs,
            "trusted_contacts": self.trusted_contacts(docs),
            "similar_companies": [{"company": self.companies[o]["name"], "similarity": round(s, 2)}
                                  for o, s in sims],
            "predicted_problems": [{"problem": c, "likelihood": round(w / total, 3)}
                                   for c, w in predicted.most_common()],
            "prediction_basis": "own history + similar companies" if cases
                                else "similar companies only (new client)",
        }


# --------------------------------------------------------------------------
# Demo
# --------------------------------------------------------------------------
def _show(results: list[dict]) -> None:
    for r in results:
        d = r["tier_detail"]
        print(f"  AI #{r['ai_rank']} -> Trusted #{r['trusted_rank']} | {r['doc_id']} {r['title']}")
        print(f"      proof : {r['evidence']}")
        print(f"      tier  : {r['tier']}  (confidence: {d['confidence']}, basis: {d['basis']})")
        print(f"      action: {d['action']}")
        if d["stale"]:
            print(f"      note  : {d['reason']}")
        print(f"      score : ai={r['ai_score']:.2f} trust={r['trust_score']:.2f} "
