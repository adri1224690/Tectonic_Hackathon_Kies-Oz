    fb_file = Path(tempfile.gettempdir()) / "demo_precedent_feedback.json"
    fb_file.unlink(missing_ok=True)

    ps = PrecedentSystem(
        base / "mockmockCompaniesDB.json", base / "mockProblemsDB.json",
        base / "mockDocumentDB.json", feedback_path=fb_file, reference_year=2026)

    # What the main AI engine returned for: "Brightwave asks for an inflation-based raise"
    ai_output = [
        {"doc_id": "doc-003", "ai_score": 0.93},
        {"doc_id": "doc-008", "ai_score": 0.90},
        {"doc_id": "doc-001", "ai_score": 0.72},
        {"doc_id": "doc-010", "ai_score": 0.55},
    ]
    ctx = dict(company_id="comp-001", problem_category="salary_adjustment")

    print("=== Day 1: no feedback yet (AI order is preserved) ===")
    _show(ps.verify(ai_output, **ctx))

    # Consultants work with the results and give feedback
    for who in ["cons-A", "cons-B", "cons-C"]:
        ps.record_use("doc-008", who, solved=True, **ctx)
        ps.upvote("doc-008", who, **ctx)
    ps.upvote("doc-008", "cons-A", comment="Same inflation clause we needed", **ctx)
    for who in ["cons-A", "cons-D"]:
        ps.record_use("doc-001", who, solved=True, **ctx)
        ps.upvote("doc-001", who, **ctx)
    for who in ["cons-B", "cons-C", "cons-D"]:
        ps.record_use("doc-003", who, solved=False, **ctx)
        ps.downvote("doc-003", who, **ctx)

    print("\n=== Later: same AI output, now backed by consultant precedent ===")
    _show(ps.verify(ai_output, **ctx))

    print("\n=== Trusted contacts for these documents ===")
    for c in ps.trusted_contacts([r["doc_id"] for r in ai_output], top_n=3):
        print(f"  {c['name']}: {c['reliability']} {c['documents']}")

    print("\n=== Client profile (Brightwave) ===")
    p = ps.client_profile("comp-001")
    print(json.dumps({k: p[k] for k in ("company", "cases_total", "solve_rate",
                                        "problem_categories", "predicted_problems",
                                        "prediction_basis")}, indent=2))
