#!/usr/bin/env python3
"""Feedback-driven client document retrieval prototype.

The prototype accepts the two supplied document formats:

* ``{"documents": [...]}`` with ``company_id`` and ``cases_solved``
* ``{"documents": [...]}`` without those optional fields

It deliberately keeps the document fields used by the hackathon mock data
(``upvotes``, ``downvotes``, ``rating``, ``referenced_documents``, and, when
present, ``cases_solved``).  Client profiles and feedback history are stored
alongside the document collection, rather than replacing its schema.

Only the Python standard library is required.
"""

from __future__ import annotations

import argparse
import copy
import json
import math
import re
import tempfile
from collections import Counter, defaultdict
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Dict, Iterable, List, Mapping, Optional, Sequence, Tuple


STOP_WORDS = {
    "a", "an", "and", "are", "as", "at", "be", "by", "for", "from", "in",
    "is", "it", "of", "on", "or", "the", "to", "with", "update", "policy",
    "agreement", "outcome", "summary", "review", "structure", "audit",
}

# A compact, transparent domain vocabulary is preferable to opaque NLP in a
# hackathon prototype.  It lets a request using "pay" find a "salary" document.
SYNONYM_GROUPS = {
    "compensation": {
        "salary", "salaries", "pay", "wage", "wages", "compensation",
        "remuneration", "bonus", "bonuses", "allowance", "allowances",
        "cost", "living", "adjustment", "adjustments",
    },
    "overtime": {"overtime", "extra", "hours", "hour", "time"},
    "remote_work": {"remote", "hybrid", "telework", "teleworking", "homeworking"},
    "equity": {"stock", "option", "options", "equity", "shares", "share"},
    "leave": {"parental", "leave", "maternity", "paternity", "absence"},
    "collective_bargaining": {"collective", "bargaining", "union", "labour", "labor"},
    "pay_equity": {"gender", "gap", "equity", "equal", "fairness"},
    "performance": {"performance", "bonus", "bonuses", "incentive", "incentives"},
}


def utc_now() -> str:
    """Return a stable, timezone-aware timestamp for persisted audit data."""
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def normalise_text(value: Any) -> str:
    """Normalise free text for case-insensitive comparisons."""
    return re.sub(r"\s+", " ", str(value or "").strip().casefold())


def slug(value: Any) -> str:
    """Create a predictable identifier when a source record lacks company_id."""
    result = re.sub(r"[^a-z0-9]+", "-", normalise_text(value)).strip("-")
    return result or "unknown-company"


def tokens(value: Any) -> List[str]:
    """Extract useful word tokens from a title or a consultant request."""
    raw_tokens = re.findall(r"[a-z0-9]+", normalise_text(value))
    output: List[str] = []
    for token in raw_tokens:
        if token in STOP_WORDS or len(token) < 2:
            continue
        # Small singularisation step without pulling in a linguistic dependency.
        if token.endswith("ies") and len(token) > 4:
            token = token[:-3] + "y"
        elif token.endswith("s") and not token.endswith("ss") and len(token) > 3:
            token = token[:-1]
        output.append(token)
    return output


def topic_labels(value: Any) -> set[str]:
    """Return direct words plus domain-topic labels for semantic matching."""
    raw = set(tokens(value))
    labels = set(raw)
    for label, words in SYNONYM_GROUPS.items():
        if raw.intersection(words):
            labels.add(label)
    return labels


def overlap_score(left: Any, right: Any) -> float:
    """Score problem similarity from direct terms and domain-topic labels."""
    left_words = set(tokens(left))
    right_words = set(tokens(right))
    if not left_words or not right_words:
        return 0.0

    direct_coverage = len(left_words.intersection(right_words)) / len(left_words)
    left_topics = topic_labels(left)
    right_topics = topic_labels(right)
    semantic_topics = (left_topics - left_words).intersection(right_topics - right_words)
    # A query that has a recognised topic can still match a differently worded title.
    topic_coverage = len(semantic_topics) / max(1, len(left_topics - left_words))
    return min(1.0, 0.70 * direct_coverage + 0.30 * topic_coverage)


def _read_json(path: Path) -> Dict[str, Any]:
    try:
        with path.open("r", encoding="utf-8") as handle:
            payload = json.load(handle)
    except FileNotFoundError as error:
        raise FileNotFoundError(f"JSON file not found: {path}") from error
    except json.JSONDecodeError as error:
        raise ValueError(f"Invalid JSON in {path}: {error}") from error
    if not isinstance(payload, dict):
        raise ValueError(f"Expected a JSON object in {path}")
    return payload


def _atomic_write_json(path: Path, payload: Mapping[str, Any]) -> None:
    """Write JSON atomically so feedback cannot leave a half-written database."""
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(
        mode="w", encoding="utf-8", dir=path.parent, prefix=f".{path.name}.", delete=False
    ) as handle:
        json.dump(payload, handle, indent=2, ensure_ascii=False)
        handle.write("\n")
        temporary_path = Path(handle.name)
    temporary_path.replace(path)


def load_document_database(path: str | Path) -> Dict[str, Any]:
    """Load the original document envelope and validate its ``documents`` list."""
    payload = _read_json(Path(path))
    documents = payload.get("documents")
    if not isinstance(documents, list):
        raise ValueError("Document JSON must contain a 'documents' array")
    for document in documents:
        if not isinstance(document, dict) or not document.get("id"):
            raise ValueError("Every document must be an object with an 'id'")
    return payload


def load_profile_store(path: str | Path) -> Dict[str, Any]:
    """Load the optional profile sidecar, returning a valid empty store if absent."""
    profile_path = Path(path)
    if not profile_path.exists():
        return {"profiles": {}}
    payload = _read_json(profile_path)
    if not isinstance(payload.get("profiles"), dict):
        raise ValueError("Profile JSON must contain a 'profiles' object")
    return payload


def company_profile_key(company_id: Optional[str], company_name: Optional[str]) -> str:
    if company_id:
        return f"company_id:{normalise_text(company_id)}"
    if company_name:
        return f"company_name:{slug(company_name)}"
    raise ValueError("Provide either company_id or company_name")


def _safe_list(value: Any) -> List[Any]:
    return list(value) if isinstance(value, list) else []


def _non_empty_strings(values: Iterable[Any]) -> List[str]:
    return [str(item) for item in values if str(item or "").strip()]


def _most_common(counter: Counter[str], fallback: Optional[str] = None) -> Optional[str]:
    return counter.most_common(1)[0][0] if counter else fallback


class DocumentRankingService:
    """Build client profiles, rank documents, and persist consultant feedback."""

    def __init__(self, document_path: str | Path, profile_path: str | Path):
        self.document_path = Path(document_path)
        self.profile_path = Path(profile_path)

    def _document_payload(self) -> Dict[str, Any]:
        return load_document_database(self.document_path)

    @staticmethod
    def _client_documents(
        documents: Sequence[Mapping[str, Any]],
        company_id: Optional[str],
        company_name: Optional[str],
    ) -> List[Mapping[str, Any]]:
        normalised_id = normalise_text(company_id)
        normalised_name = normalise_text(company_name)
        id_matches: List[Mapping[str, Any]] = []
        name_matches: List[Mapping[str, Any]] = []
        for document in documents:
            document_id = normalise_text(document.get("company_id"))
            document_name = normalise_text(document.get("company_involved"))
            if normalised_id and document_id == normalised_id:
                id_matches.append(document)
            if normalised_name and document_name == normalised_name:
                name_matches.append(document)
        # Prefer a stable ID, but fall back to the name for MockupDB.json, which
        # intentionally has no company_id field.
        return id_matches or name_matches

    def build_or_update_client_profile(
        self,
        *,
        company_id: Optional[str] = None,
        company_name: Optional[str] = None,
        country: Optional[str] = None,
        company_type: Optional[str] = None,
        industry: Optional[str] = None,
        department: Optional[str] = None,
        past_question: Optional[str] = None,
    ) -> Dict[str, Any]:
        """Derive a profile from past documents and merge new client signals.

        ``company_type``, ``industry``, and ``department`` are optional because
        neither mock collection contains them.  They are retained when the
        consultant knows them and used in future matching.
        """
        key = company_profile_key(company_id, company_name)
        payload = self._document_payload()
        documents = payload["documents"]
        matching_documents = self._client_documents(documents, company_id, company_name)

        profile_store = load_profile_store(self.profile_path)
        previous = copy.deepcopy(profile_store["profiles"].get(key, {}))
        country_counts: Counter[str] = Counter(
            str(document["country"])
            for document in matching_documents
            if document.get("country")
        )
        title_token_counts: Counter[str] = Counter()
        employee_documents: Dict[str, set[str]] = defaultdict(set)
        employee_cases: Dict[str, set[str]] = defaultdict(set)
        source_documents: set[str] = set(_safe_list(previous.get("source_documents")))
        past_cases: set[str] = set(_safe_list(previous.get("past_cases")))

        for document in matching_documents:
            document_id = str(document["id"])
            source_documents.add(document_id)
            title_token_counts.update(tokens(document.get("title")))
            cases = _non_empty_strings(_safe_list(document.get("cases_solved")))
            past_cases.update(cases)
            for employee in _non_empty_strings(_safe_list(document.get("employees_involved"))):
                employee_documents[employee].add(document_id)
                employee_cases[employee].update(cases)

        # Preserve historic employee expertise when a later source is less rich.
        for person in _safe_list(previous.get("reliable_points_of_contact")):
            if isinstance(person, dict) and person.get("name"):
                employee_documents[str(person["name"])].update(_safe_list(person.get("documents")))
                employee_cases[str(person["name"])].update(_safe_list(person.get("cases_solved")))

        questions = _non_empty_strings(_safe_list(previous.get("past_questions")))
        if past_question and past_question not in questions:
            questions.append(past_question)

        # Titles represent historical cases when no structured case-question field exists.
        precedent_titles = _non_empty_strings(
            document.get("title") for document in matching_documents
        )
        topic_candidates = [topic for topic, _ in title_token_counts.most_common(12)]
        profile = {
            "profile_id": key,
            "company_id": company_id or previous.get("company_id"),
            "company_name": company_name
            or previous.get("company_name")
            or _most_common(
                Counter(
                    str(document.get("company_involved"))
                    for document in matching_documents
                    if document.get("company_involved")
                )
            ),
            "country": country or previous.get("country") or _most_common(country_counts),
            "company_type": company_type or previous.get("company_type"),
            "industry": industry or previous.get("industry"),
            "department": department or previous.get("department"),
            "source_documents": sorted(source_documents),
            "past_cases": sorted(past_cases),
            "past_questions": questions,
            "precedent_titles": sorted(set(precedent_titles)),
            "problem_topics": topic_candidates,
            "reliable_points_of_contact": [
                {
                    "name": name,
                    "documents": sorted(employee_documents[name]),
                    "cases_solved": sorted(employee_cases[name]),
                }
                for name in sorted(
                    employee_documents,
                    key=lambda employee: (
                        len(employee_cases[employee]),
                        len(employee_documents[employee]),
                        employee,
                    ),
                    reverse=True,
                )
            ],
            "history_summary": {
                "document_count": len(source_documents),
                "case_count": len(past_cases),
                "last_built_at": utc_now(),
            },
        }
        profile_store["profiles"][key] = profile
        _atomic_write_json(self.profile_path, profile_store)
        return profile

    @staticmethod
    def _reference_counts(documents: Sequence[Mapping[str, Any]]) -> Counter[str]:
        counts: Counter[str] = Counter()
        for document in documents:
            counts.update(_non_empty_strings(_safe_list(document.get("referenced_documents"))))
        return counts

    @classmethod
    def usefulness_score(
        cls, document: Mapping[str, Any], reference_counts: Mapping[str, int]
    ) -> float:
        """Return a 0–100 trust score from votes, solved cases, and citations.

        The vote portion uses a Beta(1,1) prior.  New documents therefore begin
        neutral instead of receiving an undeserved score of zero, while repeated
        consultant feedback moves the score progressively.
        """
        upvotes = max(0, int(document.get("upvotes") or 0))
        downvotes = max(0, int(document.get("downvotes") or 0))
        successes = len(_safe_list(document.get("cases_solved")))
        inbound_references = max(0, int(reference_counts.get(str(document.get("id")), 0)))

        feedback_quality = (upvotes + 1) / (upvotes + downvotes + 2)
        case_success = min(1.0, successes / 3.0)
        citation_support = min(1.0, inbound_references / 3.0)
        return round(100.0 * (0.75 * feedback_quality + 0.15 * case_success + 0.10 * citation_support), 2)

    @staticmethod
    def _company_signal_score(
        document: Mapping[str, Any], profile: Mapping[str, Any]
    ) -> float:
        compared = 0
        matches = 0
        for field in ("country", "company_type", "industry", "department"):
            desired = normalise_text(profile.get(field))
            actual = normalise_text(document.get(field))
            if desired and actual:
                compared += 1
                matches += int(desired == actual)
        return matches / compared if compared else 0.0

    @staticmethod
    def _same_company(document: Mapping[str, Any], profile: Mapping[str, Any]) -> bool:
        profile_id = normalise_text(profile.get("company_id"))
        document_id = normalise_text(document.get("company_id"))
        if profile_id and document_id:
            return profile_id == document_id
        profile_name = normalise_text(profile.get("company_name"))
        return bool(profile_name and profile_name == normalise_text(document.get("company_involved")))

    @staticmethod
    def _recency_score(year: Any, newest_year: int) -> float:
        try:
            document_year = int(year)
        except (TypeError, ValueError):
            return 0.0
        # A seven-year linear window is explainable and avoids a hard cut-off.
        return max(0.0, min(1.0, 1.0 - (newest_year - document_year) / 7.0))

    def rank_documents(
        self,
        request: Mapping[str, Any],
        profile: Mapping[str, Any],
        limit: int = 5,
    ) -> List[Dict[str, Any]]:
        """Rank documents using problem, client, company, and trust signals."""
        if limit < 1:
            raise ValueError("limit must be at least 1")
        documents = self._document_payload()["documents"]
        reference_counts = self._reference_counts(documents)
        years = [int(document["year"]) for document in documents if str(document.get("year", "")).isdigit()]
        newest_year = max(years, default=datetime.now(timezone.utc).year)
        problem = request.get("problem") or request.get("query") or request.get("title") or ""
        requested_case = normalise_text(request.get("case_id"))
        profile_history = " ".join(
            _non_empty_strings(profile.get("problem_topics", []))
            + _non_empty_strings(profile.get("past_questions", []))
            + _non_empty_strings(profile.get("precedent_titles", []))
        )
        ranked: List[Dict[str, Any]] = []

        for document in documents:
            problem_relevance = overlap_score(problem, document.get("title"))
            profile_alignment = overlap_score(profile_history, document.get("title"))
            same_company = self._same_company(document, profile)
            company_similarity = self._company_signal_score(document, profile)
            has_case_precedent = bool(
                requested_case
                and requested_case
                in {normalise_text(value) for value in _safe_list(document.get("cases_solved"))}
            )
            usefulness = self.usefulness_score(document, reference_counts)
            recency = self._recency_score(document.get("year"), newest_year)

            score = (
                0.48 * problem_relevance
                + 0.16 * float(same_company)
                + 0.10 * company_similarity
                + 0.10 * (usefulness / 100.0)
                + 0.06 * profile_alignment
                + 0.05 * recency
                + 0.05 * float(has_case_precedent)
            )
            reasons: List[str] = []
            if problem_relevance:
                reasons.append("matches the requested problem")
            if same_company:
                reasons.append("is precedent for this client")
            elif company_similarity:
                reasons.append("matches available company signals")
            if has_case_precedent:
                reasons.append("matches the requested past case")
            if usefulness >= 60:
                reasons.append("has strong consultant feedback")
            elif reference_counts.get(str(document.get("id")), 0):
                reasons.append("is referenced by other documents")

            ranked.append(
                {
                    "rank": 0,  # assigned after sorting
                    "score": round(100.0 * score, 2),
                    "usefulness_score": usefulness,
                    "document": copy.deepcopy(document),
                    "signals": {
                        "problem_relevance": round(problem_relevance, 3),
                        "same_company": same_company,
                        "company_similarity": round(company_similarity, 3),
                        "profile_alignment": round(profile_alignment, 3),
                        "case_precedent": has_case_precedent,
                        "recency": round(recency, 3),
                    },
                    "reasons": reasons or ["baseline recommendation; add more request signals"],
                }
            )

        ranked.sort(
            key=lambda item: (
                item["score"],
                item["usefulness_score"],
                str(item["document"].get("year", "")),
            ),
            reverse=True,
        )
        for index, item in enumerate(ranked[:limit], start=1):
            item["rank"] = index
        return ranked[:limit]

    def record_feedback(
        self,
        *,
        document_id: str,
        vote: str,
        consultant: Optional[str] = None,
        client_id: Optional[str] = None,
        request_id: Optional[str] = None,
        note: Optional[str] = None,
    ) -> Dict[str, Any]:
        """Persist an up/down vote, update ``rating``, and return the document."""
        normalised_vote = normalise_text(vote)
        if normalised_vote not in {"up", "down"}:
            raise ValueError("vote must be 'up' or 'down'")

        payload = self._document_payload()
        documents = payload["documents"]
        selected = next(
            (document for document in documents if str(document.get("id")) == str(document_id)), None
        )
        if selected is None:
            raise ValueError(f"Unknown document id: {document_id}")

        counter_field = "upvotes" if normalised_vote == "up" else "downvotes"
        selected[counter_field] = max(0, int(selected.get(counter_field) or 0)) + 1
        reference_counts = self._reference_counts(documents)
        selected["rating"] = self.usefulness_score(selected, reference_counts)
        event = {
            "event_type": "document_feedback",
            "timestamp": utc_now(),
            "document_id": str(document_id),
            "vote": normalised_vote,
            "consultant": consultant,
            "client_id": client_id,
            "request_id": request_id,
            "note": note,
            "rating_after_feedback": selected["rating"],
        }
        # This optional top-level history is additive; the original documents
        # array and every existing field remain intact.
        feedback_events = payload.setdefault("feedback_events", [])
        if not isinstance(feedback_events, list):
            raise ValueError("Existing 'feedback_events' must be an array")
        feedback_events.append(event)
        _atomic_write_json(self.document_path, payload)
        return {"document": copy.deepcopy(selected), "feedback_event": event}


def profile_path_for(documents: str | Path, requested_path: Optional[str]) -> Path:
    return Path(requested_path) if requested_path else Path(documents).with_name("client_profiles.json")


def _profile_arguments(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--company-id", help="Stable company ID, when available")
    parser.add_argument("--company-name", help="Company name (required if company ID is unknown)")
    parser.add_argument("--country", help="Country signal, for example Belgium")
    parser.add_argument("--company-type", help="Optional company-type signal")
    parser.add_argument("--industry", help="Optional industry signal")
    parser.add_argument("--department", help="Optional department signal")


def _build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    subparsers = parser.add_subparsers(dest="command", required=True)

    profile = subparsers.add_parser("profile", help="Build or update a client profile")
    profile.add_argument("--documents", required=True, help="Path to MockupDB.json or mockDocumentDB.json")
    profile.add_argument("--profiles", help="Profile sidecar JSON (defaults beside --documents)")
    _profile_arguments(profile)
    profile.add_argument("--past-question", help="Optional new historical client question to retain")

    search = subparsers.add_parser("search", help="Build the profile and return ranked documents")
    search.add_argument("--documents", required=True, help="Path to document JSON")
    search.add_argument("--profiles", help="Profile sidecar JSON (defaults beside --documents)")
    _profile_arguments(search)
    search.add_argument("--problem", required=True, help="New client request/problem text")
    search.add_argument("--case-id", help="Optional structured past-case ID")
    search.add_argument("--limit", type=int, default=5, help="Maximum recommendations (default: 5)")

    feedback = subparsers.add_parser("feedback", help="Record a consultant's vote after opening a document")
    feedback.add_argument("--documents", required=True, help="Path to document JSON to update")
    feedback.add_argument("--profiles", help="Accepted for CLI consistency; feedback is written to --documents")
    feedback.add_argument("--document-id", required=True)
    feedback.add_argument("--vote", required=True, choices=("up", "down"))
    feedback.add_argument("--consultant", help="Optional consultant identifier")
    feedback.add_argument("--client-id", help="Optional client identifier for the audit event")
    feedback.add_argument("--request-id", help="Optional request/case identifier for the audit event")
    feedback.add_argument("--note", help="Optional explanation of the vote")

    show = subparsers.add_parser("show-profile", help="Print a saved client profile")
    show.add_argument("--documents", required=True, help="Used to resolve the default profile sidecar")
    show.add_argument("--profiles", help="Profile sidecar JSON (defaults beside --documents)")
    show.add_argument("--company-id")
    show.add_argument("--company-name")
    return parser


def _profile_from_args(service: DocumentRankingService, args: argparse.Namespace) -> Dict[str, Any]:
    return service.build_or_update_client_profile(
        company_id=args.company_id,
        company_name=args.company_name,
        country=args.country,
        company_type=args.company_type,
        industry=args.industry,
        department=args.department,
        past_question=getattr(args, "past_question", None),
    )


def main(argv: Optional[Sequence[str]] = None) -> int:
    parser = _build_parser()
    args = parser.parse_args(argv)
    profiles = profile_path_for(args.documents, args.profiles)
    service = DocumentRankingService(args.documents, profiles)

    try:
        if args.command == "profile":
            result: Any = _profile_from_args(service, args)
        elif args.command == "search":
            profile = _profile_from_args(service, args)
            request = {"problem": args.problem, "case_id": args.case_id}
            result = {
                "client_profile": profile,
                "request": request,
                "recommendations": service.rank_documents(request, profile, args.limit),
            }
        elif args.command == "feedback":
            result = service.record_feedback(
                document_id=args.document_id,
                vote=args.vote,
                consultant=args.consultant,
                client_id=args.client_id,
                request_id=args.request_id,
                note=args.note,
            )
        elif args.command == "show-profile":
            key = company_profile_key(args.company_id, args.company_name)
            result = load_profile_store(profiles)["profiles"].get(key)
            if result is None:
                raise ValueError(f"No saved profile for {key}")
        else:  # defensive: argparse limits the choices above
            raise ValueError(f"Unsupported command: {args.command}")
    except (FileNotFoundError, ValueError) as error:
        parser.error(str(error))

    print(json.dumps(result, indent=2, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
